rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for ID boundary
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /media_items/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    match /travel_spots/{spotId} {
      allow read: if true;
      allow write: if true;
    }

    match /cd_reviews/{cdId} {
      allow read: if true;
      allow write: if true;
    }

    match /my_cd_collection/{cdId} {
      allow read: if true;
      allow write: if true;
    }

    match /guestbook_entries/{entryId} {
      allow read: if true;
      allow write: if true;
    }

    match /profile_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /ilchon_friends/{friendId} {
      allow read: if true;
      allow write: if true;
    }

    match /ilchon_notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
